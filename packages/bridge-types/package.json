{
  "name": "@xyva/bridge-types",
  "version": "0.1.1",
  "description": "Shared bridge protocol types and provider client for XYVA products and the local agent.",
  "private": false,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xyva-ai/xyva-platform-packages.git",
    "directory": "packages/bridge-types"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "devDependencies": {
    "tsup": "9.0.0"
  },
  "dependencies": {
    "@xyva/contracts": "0.1.0"
  },
  "scripts": {
    "build": "npm run build --workspace @xyva/contracts && tsup src/index.ts --format esm --dts --outDir dist --clean --external @xyva/contracts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run build"
  }
}
