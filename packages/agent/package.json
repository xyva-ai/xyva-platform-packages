{
  "name": "@xyva/agent",
  "version": "0.1.15",
  "description": "Local test agent for xyva.ai.",
  "private": false,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xyva-ai/xyva-platform-packages.git",
    "directory": "packages/agent"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "bin": {
    "agent": "dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "dependencies": {
    "@axe-core/playwright": "4.14.0",
    "@xyva/bridge-types": "0.1.1",
    "@xyva/contracts": "0.1.0",
    "body-parser": "2.4.0",
    "chalk": "6.0.1",
    "commander": "15.0.0",
    "cors": "2.8.6",
    "express": "5.3.0",
    "open": "11.0.4",
    "playwright": "1.64.1",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/ws": "8.18.2",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "node-gyp": "13.1.0"
  },
  "scripts": {
    "build": "npm run build --workspace @xyva/contracts && npm run build --workspace @xyva/bridge-types && tsup src/index.ts src/cli.ts --format esm --dts --outDir dist --clean --external playwright --external playwright-core --external chromium-bidi --external @axe-core/playwright --external axe-core --external @xyva/contracts && node scripts/build-windows-secure-store.mjs",
    "dev": "npm run build --workspace @xyva/bridge-types && tsx src/cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run build"
  }
}
