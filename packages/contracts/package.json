{
  "name": "@xyva/contracts",
  "version": "0.1.0",
  "description": "Versioned public contracts for XYVA products.",
  "private": false,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xyva-ai/xyva-platform-packages.git",
    "directory": "packages/contracts"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./providers/v1": {
      "types": "./dist/providers/v1.d.ts",
      "import": "./dist/providers/v1.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "devDependencies": {
    "tsup": "9.0.0"
  },
  "scripts": {
    "build": "tsup src/index.ts src/providers/v1.ts --format esm --dts --outDir dist --clean",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run build"
  }
}
